# Always install devDependencies, even when NODE_ENV=production.
#
# Cloudflare Pages builds run with NODE_ENV=production, and pnpm 9 (pinned via "packageManager" in
# package.json) skips devDependencies in that case. The build itself needs them — tsx for the
# sitemap/RSS steps, vite/vinxi for the web build — so without this the production build fails
# with "tsx: not found". (pnpm 10, Cloudflare's default before the pin, installed them anyway.)
production=false
