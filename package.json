{
  "name": "prepora",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -c \"blue,green\" -n \"WEB,PYTHON\" \"pnpm --filter @prepora/web dev\" \"cd apps/scraper && ./venv/bin/uvicorn main:app --reload --port 8000\"",
    "build": "pnpm --filter @prepora/web build",
    "start": "pnpm --filter @prepora/web start",
    "lint": "biome check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @prepora/db db:generate",
    "db:migrate": "pnpm --filter @prepora/db db:migrate",
    "db:check": "pnpm --filter @prepora/db db:check",
    "db:reset": "pnpm --filter @prepora/db db:reset",
    "db:studio": "pnpm --filter @prepora/db db:studio",
    "db:seed-exams": "pnpm --filter @prepora/db db:seed-exams",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:import": "cd apps/pipeline && ./venv/bin/python -m prepora_pipeline.cli import-markdown --content-dir ../../content",
    "content:duplicates": "tsx scripts/check-duplicates.ts",
    "content:sitemap": "tsx scripts/generate-sitemap.ts",
    "content:rss": "tsx scripts/generate-rss.ts",
    "content:report": "tsx scripts/content-report.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/workers-types": "^5.20260901.1",
    "@playwright/test": "^1.49.0",
    "@prepora/content": "workspace:*",
    "@prepora/db": "workspace:*",
    "concurrently": "^10.0.5",
    "drizzle-orm": "^0.45.2",
    "puppeteer": "^25.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.128.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "zod": "^3",
      "@tanstack/directive-functions-plugin": "~1.120.0",
      "@tanstack/history": "~1.120.0",
      "@tanstack/react-router": "~1.120.0",
      "@tanstack/react-router-devtools": "~1.120.0",
      "@tanstack/react-start": "~1.120.0",
      "@tanstack/react-start-client": "~1.120.0",
      "@tanstack/react-start-plugin": "~1.120.0",
      "@tanstack/react-start-router-manifest": "~1.120.0",
      "@tanstack/react-start-server": "~1.120.0",
      "@tanstack/router-core": "~1.120.0",
      "@tanstack/router-devtools": "~1.120.0",
      "@tanstack/router-devtools-core": "~1.120.0",
      "@tanstack/router-generator": "~1.120.0",
      "@tanstack/router-plugin": "~1.120.0",
      "@tanstack/server-functions-plugin": "~1.120.0",
      "@tanstack/start": "~1.120.0",
      "@tanstack/start-api-routes": "~1.120.0",
      "@tanstack/start-client-core": "~1.120.0",
      "@tanstack/start-config": "~1.120.0",
      "@tanstack/start-plugin-core": "~1.120.0",
      "@tanstack/start-server-core": "~1.120.0",
      "@tanstack/start-server-functions-client": "~1.120.0",
      "@tanstack/start-server-functions-fetcher": "~1.120.0",
      "@tanstack/start-server-functions-handler": "~1.120.0",
      "@tanstack/start-server-functions-server": "~1.120.0",
      "@tanstack/start-server-functions-ssr": "~1.120.0",
      "@tanstack/zod-adapter": "~1.120.0"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "zod"
      ]
    }
  }
}
