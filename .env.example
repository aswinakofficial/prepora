# Database
DATABASE_URL="postgresql://user:password@localhost:5432/prepora"

# Auth (Better Auth)
BETTER_AUTH_SECRET="your-secret-key-min-32-chars-long-here"
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated list of extra origins allowed to call the auth API
# (localhost and the production domains are always trusted; add
# deploy-preview URLs etc. here).
BETTER_AUTH_TRUSTED_ORIGINS=""

# Google OAuth (used by Better Auth's Google social provider)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated list of email addresses granted admin access, in addition
# to any user with role="admin" in the database.
ADMIN_USERS=""

# Destructive admin operations (currently: wiping the entire database) are
# refused outright when NODE_ENV=production unless this is explicitly set
# to "true". Leave unset in production; only needed for a deliberate,
# one-off reset of a non-production environment that happens to run with
# NODE_ENV=production.
ALLOW_DESTRUCTIVE_ADMIN_OPS=""

# Object Storage (S3-compatible)
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="prepora-media"
STORAGE_REGION="auto"

# AI (Vercel AI SDK compatible)
AI_PROVIDER="google"
GOOGLE_GENERATIVE_AI_API_KEY=""
OPENAI_API_KEY=""

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Scraper / pipeline service (apps/scraper)
# Base URL Node uses to reach the Python FastAPI scraper. The admin UI
# never talks to it directly — every call is proxied through Node so the
# service token below never reaches the browser.
SCRAPER_SERVICE_URL="http://localhost:8000"
# Shared bearer token required by every apps/scraper endpoint. Generate
# one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be set to the *same* value in both this file and apps/scraper's
# own environment, or every scrape request will be rejected with 401/503.
PIPELINE_SERVICE_TOKEN=""
# Comma-separated hostnames the scraper is allowed to fetch. Requests for
# any other host — including internal/private/link-local addresses — are
# rejected before they are fetched. Extend this list (or, going forward,
# the source registry that replaces it) when adding a new source.
SCRAPER_ALLOWED_HOSTS="learn.microsoft.com,www.sanfoundry.com,www.examtopics.com,www.indiabix.com,keralapsc.gov.in"
# Comma-separated origins allowed to call the scraper's CORS-protected
# endpoints. Only relevant if something other than this Node server ever
# calls apps/scraper directly.
SCRAPER_CORS_ORIGINS="http://localhost:3000"
