# Database
# Required — the app and the scraper both refuse to start without this.
DATABASE_URL="postgresql://user:password@localhost:5432/prepora"

# Auth (Better Auth)
# Required — signs and encrypts sessions; the app refuses to start without this.
BETTER_AUTH_SECRET="your-secret-key-min-32-chars-long-here"
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated list of extra origins allowed to call the auth API
# (localhost and the production domains are always trusted; add
# deploy-preview URLs etc. here).
BETTER_AUTH_TRUSTED_ORIGINS=""

# Google OAuth (used by Better Auth's Google social provider). Optional as a
# pair — leave both empty to disable Google sign-in (email/password still
# works). Setting only one of the two is a startup error.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated list of email addresses granted admin access, in addition
# to any user with role="admin" in the database.
ADMIN_USERS=""

# Destructive admin operations (currently: wiping the entire database) are
# refused outright when NODE_ENV=production unless this is explicitly set
# to "true". Leave unset in production; only needed for a deliberate,
# one-off reset of a non-production environment that happens to run with
# NODE_ENV=production.
ALLOW_DESTRUCTIVE_ADMIN_OPS=""

# Microsoft Learn scraping is local-only: it drives a real browser and needs an interactive
# Microsoft sign-in on the machine running apps/scraper. Unless NODE_ENV is "development" (or
# "test") the admin UI locks it and the API refuses it — including when NODE_ENV is unset — unless
# this is set to "true" (a build that really does have the scraper running next to it).
ALLOW_LOCAL_ONLY_SCRAPERS=""

# Question images (apps/pipeline/prepora_pipeline/core/media_store.py). The scraper stores images
# here and the web app serves them from /api/media/<key>. Defaults to <repo>/.data/media when unset.
# Local filesystem only for now — an S3/R2 media store using the variables below is not built yet.
MEDIA_STORAGE_DIR=""

# Object Storage (S3-compatible)
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="prepora-media"
STORAGE_REGION="auto"

# AI (Vercel AI SDK compatible)
AI_PROVIDER="google"
GOOGLE_GENERATIVE_AI_API_KEY=""
OPENAI_API_KEY=""

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Scraper / pipeline service (apps/scraper)
# Base URL Node uses to reach the Python FastAPI scraper. The admin UI
# never talks to it directly — every call is proxied through Node so the
# service token below never reaches the browser.
SCRAPER_SERVICE_URL="http://localhost:8000"
# Shared bearer token required by every apps/scraper endpoint. Generate
# one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be set to the *same* value in both this file and apps/scraper's
# own environment, or every scrape request will be rejected with 401/503.
PIPELINE_SERVICE_TOKEN=""
# The scraper's fetch allowlist is no longer configured here — it derives from the base_url of
# every enabled row in the `sources` table (docs/roadmap/engineering-roadmap.md item 14). To add a
# source, add a apps/pipeline/prepora_pipeline/connectors/<name>/source.yaml file and run
# `sync_sources_from_yaml()` (see apps/pipeline/prepora_pipeline/core/registry.py); to disable one
# without deleting it, flip its `enabled` column to false.
# Comma-separated origins allowed to call the scraper's CORS-protected
# endpoints. Only relevant if something other than this Node server ever
# calls apps/scraper directly.
SCRAPER_CORS_ORIGINS="http://localhost:3000"
# Base URL Node uses to reach apps/pipeline's own FastAPI wrapper (prepora_pipeline/api.py) — used
# for idempotent, occurrence-aware publishing (docs/roadmap/engineering-roadmap.md item 18). Shares
# the same PIPELINE_SERVICE_TOKEN above rather than a second credential; run it with
# `uvicorn prepora_pipeline.api:app --port 8001` from apps/pipeline.
PIPELINE_SERVICE_URL="http://localhost:8001"
